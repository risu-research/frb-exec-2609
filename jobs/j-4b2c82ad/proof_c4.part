-- c4
 theorem c4_weaker : SubsetOn (H c4d) (H c4a) (H c4s) ∧ NewlyAdmitted (H c4d) (H c4a) (H c4s) := by
  constructor
  · intro e _ hi
    simpa [H, Holds, c4a, c4s, evalB, evalI] using hi
  · refine ⟨mkEnv [0,0,1,1] [], ?_⟩
    simp [H, Holds, mkEnv, c4d, c4a, c4s, evalB, evalI]
 theorem c4_channel : AcceptsBehavior (H c4d) (H c4b) (H c4s) ∧ ViolatesIntent (H c4d) (H c4a) (H c4b) := by
  constructor
  · intro e _ hb
    simpa [H, Holds, c4b, c4s, evalB, evalI] using hb
  · refine ⟨mkEnv [0,0,1,1] [], ?_⟩
    simp [H, Holds, mkEnv, c4d, c4a, c4b, evalB, evalI]
 theorem c4_qa : Safe (H c4d) (H c4a) (H c4q0) ∧ ¬ Covers (H c4d) (H c4a) (H c4q0) := by
  constructor
  · intro e _ hi hq
    simp [H, Holds, c4a, c4q0, evalB, evalI] at hi hq
  · intro hc
    have h := hc (mkEnv [0,0,1,1] []) (by simp [H, Holds, mkEnv, c4d, evalB, evalI]) (by simp [H, Holds, mkEnv, c4a, evalB, evalI])
    simpa [H, Holds, mkEnv, c4q0, evalB, evalI] using h
 theorem c4_qb : Safe (H c4d) (H c4a) (H c4q1) ∧ ¬ Covers (H c4d) (H c4a) (H c4q1) := by
  constructor
  · intro e _ hi hq
    simp [H, Holds, c4a, c4q1, evalB, evalI] at hi hq
  · intro hc
    have h := hc (mkEnv [0,0,0,0] []) (by simp [H, Holds, mkEnv, c4d, evalB, evalI]) (by simp [H, Holds, mkEnv, c4a, evalB, evalI])
    simpa [H, Holds, mkEnv, c4q1, evalB, evalI] using h
 theorem c4_full : Safe (H c4d) (H c4a) (H c4all) ∧ Covers (H c4d) (H c4a) (H c4all) := by
  constructor
  · intro e _ hi hk
    simp [H, Holds, c4a, c4all, c4q0, c4q1, evalB, evalI] at hi hk
  · intro e _ hni
    simp [H, Holds, c4a, c4all, c4q0, c4q1, evalB, evalI] at hni ⊢
    omega
 theorem c4_exact : GuardAccepts (H c4d) (H c4all) (H c4s) ↔ SubsetOn (H c4d) (H c4s) (H c4a) :=
  q7 (H c4d) (H c4a) (H c4all) (H c4s) c4_full.1 c4_full.2
